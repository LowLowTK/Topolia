---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { publishedOnly, formatDateFR } from '../../lib/content-helpers';

export async function getStaticPaths() {
  const entries = publishedOnly(await getCollection('minute-topo'));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://topolia.fr';
const pageUrl = `${siteUrl}/minute-topo/${entry.id}/`;

// Format court type astuce : Article + breadcrumb suffisent, la concision
// du contenu fait le reste pour les featured snippets.
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.excerpt,
    datePublished: entry.data.date.toISOString(),
    dateModified: entry.data.date.toISOString(),
    author: {
      '@type': 'Person',
      name: 'Loïc',
      jobTitle: 'Géomètre-topographe',
      url: `${siteUrl}/a-propos`,
    },
    publisher: {
      '@type': 'Organization',
      name: 'Topolia',
      url: siteUrl,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Minute topo', item: `${siteUrl}/minute-topo/` },
      { '@type': 'ListItem', position: 2, name: entry.data.title, item: pageUrl },
    ],
  },
]);
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt} jsonLd={jsonLd}>
  <article class="container minute-page">
    <a href="/minute-topo/" class="back-link">← Toutes les minutes topo</a>

    <header class="minute-header">
      <span class="minute-badge">Minute topo</span>
      <h1 class="minute-title">{entry.data.title}</h1>
      <p class="minute-excerpt">{entry.data.excerpt}</p>
      <p class="minute-date">
        Publié le <time datetime={entry.data.date.toISOString()}>
          {formatDateFR(entry.data.date)}</time
        >
      </p>
    </header>

    <div class="minute-content prose">
      <Content />
    </div>

    {
      entry.data.tags.length > 0 && (
        <ul class="minute-tags">
          {entry.data.tags.map((tag) => (
            <li>#{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>

<style>
  .minute-page {
    padding: 40px 0 80px;
    max-width: var(--content-max);
  }
  .back-link {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--ink-3);
    text-decoration: none;
    margin-bottom: 32px;
    padding: 6px 10px;
    border-radius: 6px;
  }
  .back-link:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .minute-header {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 32px;
  }
  .minute-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .minute-title {
    font-family: var(--display);
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--ink);
  }
  .minute-excerpt {
    margin-top: 16px;
    font-size: 1.15rem;
    color: var(--ink-3);
    line-height: 1.5;
  }
  .minute-date {
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .minute-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-top: 32px;
  }
  .minute-tags li {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  /* Prose typo */
  .prose :global(h2) {
    font-family: var(--display);
    font-size: 1.4rem;
    font-weight: 700;
    margin: 32px 0 12px;
    color: var(--ink);
  }
  .prose :global(h3) {
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 24px 0 10px;
    color: var(--ink-2);
  }
  .prose :global(p) {
    margin: 14px 0;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 14px 0 14px 22px;
    color: var(--ink-2);
    line-height: 1.65;
  }
  .prose :global(li) {
    margin: 4px 0;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
</style>
