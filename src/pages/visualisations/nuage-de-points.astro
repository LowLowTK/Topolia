---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Visualisation nuage de points</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #060a13;
        --panel: rgba(15, 23, 42, 0.62);
        --text: #f8fafc;
        --muted: #aab8cf;
        --accent: #34e2ff;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background:
          radial-gradient(900px 520px at 72% 30%, rgba(34, 211, 238, 0.1), transparent 60%),
          radial-gradient(700px 480px at 20% 85%, rgba(192, 38, 211, 0.07), transparent 60%),
          var(--bg);
        color: var(--text);
        font-family:
          Onest,
          Inter,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
      }

      #viewer {
        position: fixed;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        touch-action: pan-y;
      }

      /* Pastille compacte en haut à gauche : n'empiète plus sur le modèle. */
      .hud-tag {
        position: fixed;
        top: 14px;
        left: 14px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border: 1px solid rgba(140, 180, 230, 0.16);
        border-radius: 999px;
        background: var(--panel);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        pointer-events: none;
      }

      .hud-tag .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 8px var(--accent);
      }

      .hud-hint {
        position: fixed;
        right: 16px;
        bottom: 14px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.72rem;
        color: var(--muted);
        pointer-events: none;
      }

      /* Boutons (rejouer, plein écran) en haut à droite. */
      .controls {
        position: fixed;
        top: 12px;
        right: 12px;
        display: flex;
        gap: 8px;
      }

      .ctrl {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        padding: 0;
        border: 1px solid rgba(140, 180, 230, 0.18);
        border-radius: 10px;
        background: var(--panel);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        color: var(--text);
        cursor: pointer;
        transition:
          border-color 0.2s ease,
          color 0.2s ease,
          background 0.2s ease;
      }

      .ctrl:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(20, 30, 50, 0.7);
      }

      .ctrl svg {
        width: 18px;
        height: 18px;
      }

      .icon-collapse {
        display: none;
      }

      :fullscreen .icon-expand {
        display: none;
      }

      :fullscreen .icon-collapse {
        display: block;
      }

      @media (max-width: 620px) {
        .hud-hint {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="viewer" aria-label="Relevé d'un monument en nuage de points par drone"></canvas>

    <span class="hud-tag"><i class="dot"></i>Relevé LiDAR · drone</span>
    <span class="hud-hint">Survolez pour scanner →</span>

    <div class="controls">
      <button
        type="button"
        class="ctrl"
        id="replay"
        aria-label="Rejouer l'animation"
        title="Rejouer l'animation"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
      </button>
      <button
        type="button"
        class="ctrl"
        id="enlarge"
        aria-label="Agrandir en plein écran"
        title="Agrandir"
      >
        <svg
          class="icon-expand"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"
          ></path>
        </svg>
        <svg
          class="icon-collapse"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M4 8h3a2 2 0 0 0 2-2V3M20 8h-3a2 2 0 0 1-2-2V3M4 16h3a2 2 0 0 1 2 2v3M20 16h-3a2 2 0 0 0-2 2v3"
          ></path>
        </svg>
      </button>
    </div>

    <script>
      window.__TOPOLIA_POINT_CLOUD_VIEWER__ = true;
    </script>

    <script>
      import { initPointCloudReveal } from '../../lib/pointCloudReveal';

      const canvas = document.getElementById('viewer');
      if (canvas instanceof HTMLCanvasElement) {
        // autoplay:false → la scène reste vide jusqu'au déclenchement (scroll).
        const viewer = initPointCloudReveal(canvas, {
          modelUrl: '/models/saint-denis.glb',
          intensity: 1,
          autoplay: false,
        });

        // Démarrage : message du parent (IntersectionObserver) quand l'iframe
        // entre dans la vue. Filet de sécurité si le message n'arrive jamais.
        let kicked = false;
        const kick = () => {
          if (kicked) return;
          kicked = true;
          viewer.replay();
        };
        window.addEventListener('message', (e) => {
          if (e.data === 'topolia-pcv-play') kick();
        });
        // Signale au parent qu'on est prêt à recevoir l'ordre de jouer.
        try {
          window.parent?.postMessage('topolia-pcv-ready', '*');
        } catch {
          /* ignore */
        }
        // Sécurité : si rien ne déclenche sous 6 s, on lance quand même.
        setTimeout(kick, 6000);

        // Rejouer l'animation depuis le début.
        document.getElementById('replay')?.addEventListener('click', () => viewer.replay());

        // Plein écran : agrandit le document de l'iframe (parent : allow="fullscreen").
        document.getElementById('enlarge')?.addEventListener('click', () => {
          if (document.fullscreenElement) {
            document.exitFullscreen();
          } else {
            document.documentElement.requestFullscreen().catch(() => {});
          }
        });
      }
    </script>
  </body>
</html>
