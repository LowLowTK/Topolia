---

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Visualisation nuage de points</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #070b16;
        --panel: rgba(15, 23, 42, 0.72);
        --text: #f8fafc;
        --muted: #cbd5e1;
        --wall: #d8c9ad;
        --roof: #9f3f27;
        --ground: #3f7d3a;
        --detail: #2f3542;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background:
          radial-gradient(circle at 22% 20%, rgba(159, 63, 39, 0.2), transparent 32%),
          radial-gradient(circle at 80% 12%, rgba(216, 201, 173, 0.16), transparent 30%), var(--bg);
        color: var(--text);
        font-family:
          Onest,
          Inter,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
      }

      #viewer {
        position: fixed;
        inset: 0;
      }

      .hud {
        position: fixed;
        left: 18px;
        right: 18px;
        bottom: 16px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: end;
        pointer-events: none;
      }

      .hud-card {
        max-width: 320px;
        padding: 12px 14px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        background: var(--panel);
        backdrop-filter: blur(12px);
      }

      .hud-label {
        margin: 0 0 4px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--wall);
      }

      .hud-title {
        margin: 0;
        font-size: 0.96rem;
        line-height: 1.3;
      }

      .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }

      .legend span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 9px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        background: var(--panel);
        color: var(--muted);
        font-size: 0.78rem;
        backdrop-filter: blur(12px);
      }

      .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
      }

      .dot--ground {
        background: var(--ground);
      }

      .dot--wall {
        background: var(--wall);
      }

      .dot--roof {
        background: var(--roof);
      }

      .dot--detail {
        background: var(--detail);
      }

      @media (max-width: 620px) {
        .hud {
          align-items: stretch;
          flex-direction: column;
        }

        .hud-card {
          max-width: none;
        }

        .legend {
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="viewer" aria-label="Nuage de points anime"></canvas>

    <div class="hud">
      <div class="hud-card">
        <p class="hud-label">Nuage de points demo</p>
        <p class="hud-title">Maison en nuage de points - simulation d'un releve 3D.</p>
      </div>
      <div class="legend" aria-label="Legende">
        <span><i class="dot dot--ground"></i>sol</span>
        <span><i class="dot dot--wall"></i>murs</span>
        <span><i class="dot dot--roof"></i>toit</span>
        <span><i class="dot dot--detail"></i>details</span>
      </div>
    </div>

    <script>
      window.__TOPOLIA_POINT_CLOUD_VIEWER__ = true;
    </script>

    <script>
      import * as THREE from 'three';

      const canvas = document.getElementById('viewer');
      const scene = new THREE.Scene();
      scene.fog = new THREE.Fog(0x070b16, 8, 20);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 100);
      camera.position.set(4.8, 2.8, 6.6);
      camera.lookAt(0, -0.05, 0);

      const group = new THREE.Group();
      scene.add(group);

      const positions = [];
      const colors = [];
      const color = new THREE.Color();
      const house = {
        width: 3.4,
        depth: 2.5,
        baseY: -0.95,
        wallHeight: 1.85,
        roofHeight: 0.9,
      };
      const palette = {
        ground: 0x3f7d3a,
        wall: 0xd8c9ad,
        roof: 0x9f3f27,
        detail: 0x2f3542,
        glass: 0x6f9fc6,
        stone: 0xb8ab94,
      };

      function varied(hex, spread = 0.08) {
        color.set(hex);
        color.offsetHSL(0, 0, (Math.random() - 0.5) * spread);
        return color.getHex();
      }

      function pushPoint(x, y, z, hex, jitter = 0.015) {
        positions.push(
          x + (Math.random() - 0.5) * jitter,
          y + (Math.random() - 0.5) * jitter,
          z + (Math.random() - 0.5) * jitter,
        );
        color.set(hex);
        colors.push(color.r, color.g, color.b);
      }

      function addPlanePoints({ count, colorHex, jitter = 0.018, sampler, skip = () => false }) {
        for (let i = 0; i < count; i += 1) {
          const point = sampler();
          if (skip(point)) continue;
          pushPoint(point.x, point.y, point.z, varied(colorHex), jitter);
        }
      }

      function makeTerrain() {
        for (let i = 0; i < 2600; i += 1) {
          const x = (Math.random() - 0.5) * 7.6;
          const z = (Math.random() - 0.5) * 5.5;
          const y = Math.sin(x * 1.1) * 0.05 + Math.cos(z * 1.35) * 0.04 - 1.05;
          pushPoint(x, y, z, varied(palette.ground, 0.16), 0.04);
        }
      }

      function isFrontOpening({ x, y, z }) {
        const isFront = Math.abs(z - house.depth / 2) < 0.04;
        const door = x > -0.38 && x < 0.38 && y < 0.16;
        const leftWindow = x > -1.35 && x < -0.72 && y > 0.35 && y < 0.9;
        const rightWindow = x > 0.72 && x < 1.35 && y > 0.35 && y < 0.9;
        return isFront && (door || leftWindow || rightWindow);
      }

      function makeWalls() {
        const halfW = house.width / 2;
        const halfD = house.depth / 2;
        const wallTop = house.baseY + house.wallHeight;

        addPlanePoints({
          count: 2700,
          colorHex: palette.wall,
          jitter: 0.022,
          sampler: () => ({
            x: -halfW + Math.random() * house.width,
            y: house.baseY + Math.random() * house.wallHeight,
            z: halfD,
          }),
          skip: isFrontOpening,
        });

        addPlanePoints({
          count: 2100,
          colorHex: palette.wall,
          jitter: 0.022,
          sampler: () => ({
            x: -halfW + Math.random() * house.width,
            y: house.baseY + Math.random() * house.wallHeight,
            z: -halfD,
          }),
        });

        for (const sideX of [-halfW, halfW]) {
          addPlanePoints({
            count: 1900,
            colorHex: palette.wall,
            jitter: 0.022,
            sampler: () => ({
              x: sideX,
              y: house.baseY + Math.random() * house.wallHeight,
              z: -halfD + Math.random() * house.depth,
            }),
          });
        }

        for (let i = 0; i < 640; i += 1) {
          const t = Math.random() * 2 - 1;
          const x = t * halfW;
          const y = wallTop + (1 - Math.abs(t)) * house.roofHeight;
          pushPoint(x, y, halfD + 0.006, varied(palette.wall), 0.02);
          pushPoint(x, y, -halfD - 0.006, varied(palette.wall), 0.02);
        }
      }

      function makeRoof() {
        const halfW = house.width / 2 + 0.28;
        const halfD = house.depth / 2 + 0.22;
        const roofBase = house.baseY + house.wallHeight;
        const ridgeY = roofBase + house.roofHeight;

        for (let i = 0; i < 3600; i += 1) {
          const side = Math.random() > 0.5 ? 1 : -1;
          const u = Math.random();
          const x = side * u * halfW;
          const y = ridgeY - u * house.roofHeight;
          const z = -halfD + Math.random() * halfD * 2;
          pushPoint(x, y, z, varied(palette.roof, 0.1), 0.02);
        }
      }

      function makeDetails() {
        const frontZ = house.depth / 2 + 0.035;

        addPlanePoints({
          count: 460,
          colorHex: palette.detail,
          jitter: 0.012,
          sampler: () => ({
            x: -0.32 + Math.random() * 0.64,
            y: house.baseY + Math.random() * 1.05,
            z: frontZ,
          }),
        });

        for (const centerX of [-1.04, 1.04]) {
          addPlanePoints({
            count: 300,
            colorHex: palette.glass,
            jitter: 0.012,
            sampler: () => ({
              x: centerX - 0.28 + Math.random() * 0.56,
              y: -0.48 + Math.random() * 0.52,
              z: frontZ + 0.01,
            }),
          });
        }

        for (let i = 0; i < 900; i += 1) {
          const angle = Math.random() * Math.PI * 2;
          const radius = 1.8 + Math.random() * 2.6;
          const x = Math.cos(angle) * radius;
          const z = Math.sin(angle) * radius * 0.75;
          const y = -0.85 + Math.random() * 2.8;
          const detailColor = Math.random() > 0.58 ? palette.stone : palette.detail;
          pushPoint(x, y, z, varied(detailColor, 0.12), 0.026);
        }
      }

      makeTerrain();
      makeWalls();
      makeRoof();
      makeDetails();

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
      geometry.computeBoundingSphere();

      const material = new THREE.PointsMaterial({
        size: 0.058,
        vertexColors: true,
        transparent: true,
        opacity: 0.98,
        sizeAttenuation: true,
      });

      const points = new THREE.Points(geometry, material);
      group.add(points);

      const grid = new THREE.GridHelper(8, 12, 0x1e293b, 0x1e293b);
      grid.position.y = -1.16;
      grid.material.transparent = true;
      grid.material.opacity = 0.3;
      group.add(grid);

      const ambient = new THREE.AmbientLight(0xffffff, 1.35);
      scene.add(ambient);

      function resize() {
        const width = window.innerWidth;
        const height = window.innerHeight;
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        camera.lookAt(0, -0.05, 0);
      }

      window.addEventListener('resize', resize);
      resize();

      const clock = new THREE.Clock();

      function animate() {
        const t = clock.getElapsedTime();
        group.rotation.y = t * 0.2;
        group.rotation.x = -0.14;
        points.rotation.z = Math.sin(t * 0.55) * 0.01;
        camera.lookAt(0, -0.05, 0);
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      }

      animate();
    </script>
  </body>
</html>
