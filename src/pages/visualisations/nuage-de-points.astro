---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Visualisation nuage de points</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #070b16;
        --panel: rgba(15, 23, 42, 0.72);
        --text: #f8fafc;
        --muted: #94a3b8;
        --blue: #2d5bff;
        --cyan: #06b6d4;
        --green: #10b981;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background:
          radial-gradient(circle at 20% 20%, rgba(45, 91, 255, 0.25), transparent 32%),
          radial-gradient(circle at 80% 10%, rgba(6, 182, 212, 0.18), transparent 30%), var(--bg);
        color: var(--text);
        font-family:
          Onest,
          Inter,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
      }

      #viewer {
        position: fixed;
        inset: 0;
      }

      .hud {
        position: fixed;
        left: 18px;
        right: 18px;
        bottom: 16px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: end;
        pointer-events: none;
      }

      .hud-card {
        max-width: 320px;
        padding: 12px 14px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        background: var(--panel);
        backdrop-filter: blur(12px);
      }

      .hud-label {
        margin: 0 0 4px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--cyan);
      }

      .hud-title {
        margin: 0;
        font-size: 0.96rem;
        line-height: 1.3;
      }

      .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
      }

      .legend span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 9px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        background: var(--panel);
        color: var(--muted);
        font-size: 0.78rem;
        backdrop-filter: blur(12px);
      }

      .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
      }

      .dot--ground {
        background: var(--green);
      }

      .dot--facade {
        background: var(--cyan);
      }

      .dot--detail {
        background: var(--blue);
      }

      @media (max-width: 620px) {
        .hud {
          align-items: stretch;
          flex-direction: column;
        }

        .hud-card {
          max-width: none;
        }

        .legend {
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="viewer" aria-label="Nuage de points anime"></canvas>

    <div class="hud">
      <div class="hud-card">
        <p class="hud-label">Nuage de points demo</p>
        <p class="hud-title">
          Rotation automatique - points generes pour simuler un petit relevé 3D.
        </p>
      </div>
      <div class="legend" aria-label="Legende">
        <span><i class="dot dot--ground"></i>sol</span>
        <span><i class="dot dot--facade"></i>facade</span>
        <span><i class="dot dot--detail"></i>details</span>
      </div>
    </div>

    <script>
      window.__TOPOLIA_POINT_CLOUD_VIEWER__ = true;
    </script>

    <script type="module">
      import * as THREE from 'three';

      const canvas = document.getElementById('viewer');
      const scene = new THREE.Scene();
      scene.fog = new THREE.Fog(0x070b16, 8, 20);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 100);
      camera.position.set(5.4, 3.2, 7.2);

      const group = new THREE.Group();
      scene.add(group);

      const positions = [];
      const colors = [];
      const color = new THREE.Color();

      function pushPoint(x, y, z, hex, jitter = 0.015) {
        positions.push(
          x + (Math.random() - 0.5) * jitter,
          y + (Math.random() - 0.5) * jitter,
          z + (Math.random() - 0.5) * jitter,
        );
        color.set(hex);
        colors.push(color.r, color.g, color.b);
      }

      function makeTerrain() {
        for (let i = 0; i < 2200; i += 1) {
          const x = (Math.random() - 0.5) * 7.2;
          const z = (Math.random() - 0.5) * 4.8;
          const y = Math.sin(x * 1.25) * 0.12 + Math.cos(z * 1.4) * 0.08 - 1.05;
          pushPoint(x, y, z, 0x10b981, 0.045);
        }
      }

      function makeFacade() {
        for (let ix = 0; ix < 82; ix += 1) {
          for (let iy = 0; iy < 48; iy += 1) {
            const x = -2.8 + ix * 0.07;
            const y = -0.85 + iy * 0.06;
            const z = -1.25 + Math.sin(ix * 0.12) * 0.035;
            const isWindow =
              ((ix > 16 && ix < 28) || (ix > 46 && ix < 58)) &&
              ((iy > 12 && iy < 23) || (iy > 30 && iy < 40));
            if (isWindow && Math.random() > 0.22) continue;
            pushPoint(x, y, z, isWindow ? 0x2d5bff : 0x06b6d4, 0.025);
          }
        }
      }

      function makeScannerNoise() {
        for (let i = 0; i < 450; i += 1) {
          const angle = Math.random() * Math.PI * 2;
          const radius = 1.4 + Math.random() * 2.9;
          const x = Math.cos(angle) * radius;
          const z = Math.sin(angle) * radius * 0.7;
          const y = -0.7 + Math.random() * 2.2;
          pushPoint(x, y, z, Math.random() > 0.55 ? 0x2d5bff : 0x06b6d4, 0.03);
        }
      }

      makeTerrain();
      makeFacade();
      makeScannerNoise();

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
      geometry.computeBoundingSphere();

      const material = new THREE.PointsMaterial({
        size: 0.034,
        vertexColors: true,
        transparent: true,
        opacity: 0.92,
        sizeAttenuation: true,
      });

      const points = new THREE.Points(geometry, material);
      group.add(points);

      const grid = new THREE.GridHelper(8, 12, 0x1e293b, 0x1e293b);
      grid.position.y = -1.16;
      grid.material.transparent = true;
      grid.material.opacity = 0.36;
      group.add(grid);

      const ambient = new THREE.AmbientLight(0xffffff, 1.4);
      scene.add(ambient);

      function resize() {
        const width = window.innerWidth;
        const height = window.innerHeight;
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      }

      window.addEventListener('resize', resize);
      resize();

      const clock = new THREE.Clock();
      let pointerX = 0;
      let pointerY = 0;

      window.addEventListener('pointermove', (event) => {
        pointerX = (event.clientX / window.innerWidth - 0.5) * 0.35;
        pointerY = (event.clientY / window.innerHeight - 0.5) * 0.22;
      });

      function animate() {
        const t = clock.getElapsedTime();
        group.rotation.y = t * 0.22 + pointerX;
        group.rotation.x = -0.16 + pointerY;
        points.rotation.z = Math.sin(t * 0.55) * 0.015;
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      }

      animate();
    </script>
  </body>
</html>
