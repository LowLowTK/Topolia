---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterInline from '../components/NewsletterInline.astro';

const faqItems = [
  {
    question: 'Par quoi commencer en topographie 3D ?',
    answer:
      'Commence par comprendre le nuage de points, puis la difference entre LiDAR et photogrammetrie. Ensuite seulement, regarde le calage, les formats et le materiel.',
  },
  {
    question: 'Quelle difference entre LiDAR et photogrammetrie ?',
    answer:
      'Le LiDAR mesure directement des distances avec un laser. La photogrammetrie reconstruit une scene 3D a partir de photos qui se recouvrent.',
  },
  {
    question: 'Faut-il un drone RTK pour faire de la photogrammetrie ?',
    answer:
      'Non, mais le RTK aide beaucoup pour positionner les images. Pour un livrable precis, il faut quand meme controler le chantier avec une methode adaptee.',
  },
  {
    question: 'Quel logiciel utiliser pour ouvrir un nuage de points ?',
    answer:
      'CloudCompare est souvent le plus simple pour commencer. PDAL devient interessant quand tu veux automatiser, convertir ou filtrer des gros volumes.',
  },
  {
    question: 'Quel materiel acheter en premier ?',
    answer:
      'Avant le capteur le plus cher, pense aux accessoires qui securisent le chantier : cibles, GCP, stockage, ordinateur adapte et methode de controle.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Commencer en topographie moderne : drone, LiDAR, scanner 3D"
  description="Tu debutes en topographie 3D, LiDAR ou photogrammetrie ? Topolia t'oriente avec les notions a connaitre, les articles a lire et les outils utiles sur le terrain."
  jsonLd={JSON.stringify(faqJsonLd)}
>
  <section class="start-hero">
    <div class="container start-hero__grid">
      <div>
        <p class="eyebrow">Guide d'entree Topolia</p>
        <h1>Commencer en topographie moderne</h1>
        <p class="hero-sub">
          Drone, <a href="/glossaire/lidar/">LiDAR</a>, scanner 3D,
          <a href="/glossaire/nuage-de-points/">nuages de points</a> : Topolia t'aide a comprendre les
          bases, choisir les bons outils et eviter les pieges classiques du terrain.
        </p>
        <div class="hero-actions">
          <a href="#debuter" class="btn btn--primary">Je debute</a>
          <a href="#terrain" class="btn btn--secondary">Je suis deja sur le terrain</a>
        </div>
      </div>

      <aside class="hero-note" aria-label="Promesse editoriale">
        <span class="hero-note__label">La promesse</span>
        <p>
          Pas de jargon pour faire savant. Pas de fiche constructeur recyclee. On part des problemes
          que tu rencontres vraiment : acquisition, calage, formats, logiciels, livrables et choix
          materiel.
        </p>
      </aside>
    </div>
  </section>

  <section class="container route-grid" aria-label="Parcours recommandes">
    <article class="route-card" id="debuter">
      <p class="route-card__kicker">Parcours 1</p>
      <h2>Si tu debutes</h2>
      <p>
        Ne commence pas par comparer 12 scanners ou 8 drones. Commence par comprendre ce que tu
        produis, comment tu le controles, et pourquoi un beau rendu peut quand meme etre faux.
      </p>
      <ol class="path-list">
        <li>
          <strong>Comprendre la donnee</strong>
          <span>
            Lis d'abord <a href="/glossaire/nuage-de-points/">nuage de points</a>,
            <a href="/glossaire/lidar/">LiDAR</a> et
            <a href="/glossaire/photogrammetrie/">photogrammetrie</a>.
          </span>
        </li>
        <li>
          <strong>Comprendre le calage</strong>
          <span>
            Passe ensuite sur <a href="/glossaire/rtk/">RTK</a>,
            <a href="/glossaire/ppk/">PPK</a>,
            <a href="/glossaire/gcp/">GCP</a> et
            <a href="/glossaire/georeferencement/">georeferencement</a>.
          </span>
        </li>
        <li>
          <strong>Comprendre les livrables</strong>
          <span>
            Regarde <a href="/glossaire/mnt/">MNT</a>,
            <a href="/glossaire/mns/">MNS</a>,
            <a href="/glossaire/orthophoto/">orthophoto</a> et
            <a href="/glossaire/maillage/">maillage 3D</a>.
          </span>
        </li>
      </ol>

      <div class="scan-teaser">
        <p class="scan-teaser__label">Bientot sur iOS</p>
        <h3>Premier test LiDAR avec Topolia Scan</h3>
        <p>
          Pour t'initier sans investir dans un scanner professionnel, Topolia Scan permettra de
          realiser un petit releve interieur avec un iPhone ou un iPad compatible LiDAR. L'objectif
          n'est pas de remplacer un scanner de chantier, mais de comprendre concretement ce qu'est
          un scan 3D : les points, les trous, la trajectoire, les surfaces difficiles et les limites
          d'un releve rapide.
        </p>
        <a href="/topolia-scan/" class="scan-teaser__cta">Decouvrir Topolia Scan bientot</a>
      </div>
    </article>

    <article class="route-card route-card--pro" id="terrain">
      <p class="route-card__kicker">Parcours 2</p>
      <h2>Si tu es deja sur le terrain</h2>
      <p>
        Tu connais deja les bases ? Va directement vers les tests, les workflows et les retours de
        chantier. L'objectif ici, c'est de gagner du temps et de conforter tes choix.
      </p>
      <div class="quick-links">
        <a href="/articles/dji-matrice-4e-photogrammetrie/">Test DJI Matrice 4E</a>
        <a href="/articles/dji-zenmuse-l3-analyse-achat/">Analyse Zenmuse L3</a>
        <a href="/articles/rtc360-vs-faro-focus/">RTC360 vs FARO vs Trimble X9</a>
        <a href="/articles/pdal-introduction/">PDAL pour nuages de points</a>
        <a href="/chantiers/">Chantiers anonymises</a>
        <a href="/ressources/outils-drone-photogrammetrie/">Ressources materiel</a>
      </div>

      <div class="terrain-focus">
        <p class="terrain-focus__label">Pour aller plus vite</p>
        <h3>Tu cherches une info terrain ?</h3>
        <p>
          Pars directement d'un probleme concret : choisir un capteur, verifier un
          <a href="/glossaire/recalage/">recalage</a>, comprendre une derive
          <a href="/glossaire/slam/">SLAM</a>, convertir un fichier
          <a href="/glossaire/las/">LAS</a> / <a href="/glossaire/laz/">LAZ</a> ou comparer deux workflows
          avant un chantier.
        </p>
        <a href="/chantiers/" class="terrain-focus__cta">Voir les retours de chantier</a>
      </div>
    </article>
  </section>

  <section class="container express-section" aria-label="Parcours express 30 minutes">
    <div class="express-panel">
      <div class="express-intro">
        <p class="eyebrow">Parcours express</p>
        <h2>30 minutes pour ne plus etre perdu</h2>
        <p>
          Si tu arrives ici sans vocabulaire topo, fais ce petit parcours dans l'ordre. Tu ne vas
          pas devenir expert en une demi-heure, mais tu sauras enfin quoi lire, quoi chercher et
          pourquoi certains mots reviennent partout.
        </p>
      </div>

      <ol class="express-steps">
        <li>
          <span>5 min</span>
          <div>
            <strong>Comprends le nuage de points</strong>
            <p>
              C'est la base de tout : scanner, LiDAR drone, photogrammetrie et donnees IGN finissent
              souvent par produire ce type de fichier.
              <a href="/glossaire/nuage-de-points/">Lire la fiche</a>
            </p>
          </div>
        </li>
        <li>
          <span>5 min</span>
          <div>
            <strong>Separe LiDAR et photogrammetrie</strong>
            <p>
              L'un mesure avec un laser, l'autre reconstruit depuis des photos. Meme objectif 3D,
              pas les memes forces ni les memes pieges.
              <a href="/glossaire/lidar/">Voir LiDAR</a> ·
              <a href="/glossaire/photogrammetrie/">voir photogrammetrie</a>
            </p>
          </div>
        </li>
        <li>
          <span>10 min</span>
          <div>
            <strong>Lis un workflow complet</strong>
            <p>
              Preparation, vol, traitement, controle, export : c'est la que les mots commencent a
              s'assembler dans un vrai enchainement terrain.
              <a href="/articles/workflow-drone-complet/">Lire le workflow drone</a>
            </p>
          </div>
        </li>
        <li>
          <span>5 min</span>
          <div>
            <strong>Comprends le calage</strong>
            <p>
              RTK, PPK, GCP et georeferencement servent a une chose : eviter une belle donnee mal
              placee.
              <a href="/glossaire/rtk/">RTK</a> · <a href="/glossaire/gcp/">GCP</a> ·
              <a href="/glossaire/georeferencement/">georeferencement</a>
            </p>
          </div>
        </li>
        <li>
          <span>5 min</span>
          <div>
            <strong>Choisis ta suite</strong>
            <p>
              Si tu veux pratiquer, pars sur le LiDAR HD IGN. Si tu veux acheter, lis les tests
              materiel. Si tu veux traiter, commence par CloudCompare puis PDAL.
              <a href="/articles/lidar-hd-ign/">Manipuler une vraie donnee</a>
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="container point-cloud-section" aria-label="Visualisation d'un nuage de points">
    <div class="point-cloud-panel">
      <div class="point-cloud-copy">
        <p class="eyebrow">Visualiser</p>
        <h2>A quoi ressemble un nuage de points ?</h2>
        <p>
          Un <a href="/glossaire/nuage-de-points/">nuage de points</a>, ce n'est pas une photo.
          C'est un paquet de points 3D. Chaque point a au minimum une position, et parfois une
          couleur, une intensite laser ou une classe comme sol, vegetation ou batiment.
        </p>
        <p>
          Plus les points sont denses et bien classes, plus tu peux comprendre la scene, mesurer,
          filtrer et produire des livrables propres.
        </p>
      </div>

      <figure class="point-cloud-visual">
        <iframe
          src="/visualisations/nuage-de-points/"
          title="Visualisation animée d'un nuage de points"
          loading="lazy"
          class="point-cloud-frame"></iframe>
        <figcaption>
          <span><strong>Position</strong> x, y, z</span>
          <span><strong>Densite</strong> nombre de points</span>
          <span><strong>Classe</strong> sol, vegetation, batiment</span>
          <em>Demo legere generee dans le navigateur pour expliquer le principe.</em>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="container tool-fit-section" aria-label="Quel outil pour quel chantier">
    <div class="tool-fit-panel">
      <div class="tool-fit-intro">
        <p class="eyebrow">Choisir sans se precipiter</p>
        <h2>Quel outil pour quel chantier ?</h2>
        <p>
          La mauvaise question, c'est souvent : "quel est le meilleur materiel ?" La bonne question,
          c'est plutot : "qu'est-ce que je dois livrer, dans quel environnement, avec quel niveau de
          controle ?" Un drone, un scanner statique ou un LiDAR mobile peuvent tous produire un
          <a href="/glossaire/nuage-de-points/">nuage de points</a>, mais pas avec les memes forces.
        </p>
      </div>

      <div class="tool-cards">
        <article class="tool-card tool-card--terrain">
          <span class="tool-card__badge">Terrain ouvert</span>
          <h3>Je veux relever un terrain, une plateforme ou une carriere</h3>
          <dl class="tool-card__facts">
            <div>
              <dt>Outil conseille</dt>
              <dd>
                Drone photo +
                <a href="/glossaire/photogrammetrie/">photogrammetrie</a>
              </dd>
            </div>
            <div>
              <dt>A surveiller</dt>
              <dd>
                <a href="/glossaire/gcp/">GCP</a>, controle terrain, recouvrement et
                <a href="/glossaire/gsd/">GSD</a>
              </dd>
            </div>
          </dl>
          <p>
            Bon point d'entree en terrain degage : tu obtiens une
            <a href="/glossaire/orthophoto/">orthophoto</a>, un modele de surface et un rendu facile
            a expliquer au client.
          </p>
          <a class="tool-card__cta" href="/articles/workflow-drone-complet/"
            >Lire le workflow drone</a
          >
        </article>

        <article class="tool-card tool-card--vegetation">
          <span class="tool-card__badge">Vegetation</span>
          <h3>Je dois voir le sol sous des arbres ou des haies</h3>
          <dl class="tool-card__facts">
            <div>
              <dt>Outil conseille</dt>
              <dd>
                <a href="/glossaire/lidar/">LiDAR</a> drone, mobile ou donnees LiDAR existantes
              </dd>
            </div>
            <div>
              <dt>A surveiller</dt>
              <dd>Budget, densite utile, sous-traitance possible et besoin reel du chantier</dd>
            </div>
          </dl>
          <p>
            Le LiDAR ne traverse pas tout, mais certains retours laser peuvent atteindre le sol
            entre les feuilles et les branches, la ou une photo reste bloquee sur ce qu'elle voit.
          </p>
          <a class="tool-card__cta" href="/articles/lidar-hd-ign/"
            >Tester avec une vraie donnee IGN</a
          >
        </article>

        <article class="tool-card tool-card--building">
          <span class="tool-card__badge">Batiment</span>
          <h3>Je veux scanner une facade, une cour ou un interieur</h3>
          <dl class="tool-card__facts">
            <div>
              <dt>Outil conseille</dt>
              <dd>Scanner statique, avec export <a href="/glossaire/e57/">E57</a></dd>
            </div>
            <div>
              <dt>A surveiller</dt>
              <dd>Masques, angles morts, stations mal placees et recalage trop confiant</dd>
            </div>
          </dl>
          <p>
            Plus lent a poser, mais solide quand il faut une geometrie propre et defendable. Sur une
            facade ou un interieur, le placement des stations compte autant que le modele choisi.
          </p>
          <a class="tool-card__cta" href="/articles/rtc360-vs-faro-focus/"
            >Comparer RTC360, FARO et Trimble X9</a
          >
        </article>

        <article class="tool-card tool-card--speed">
          <span class="tool-card__badge">Vitesse</span>
          <h3>Je veux aller vite dans un couloir, un entrepot ou une cage d'escalier</h3>
          <dl class="tool-card__facts">
            <div>
              <dt>Outil conseille</dt>
              <dd>Scanner mobile ou backpack avec <a href="/glossaire/slam/">SLAM</a></dd>
            </div>
            <div>
              <dt>A surveiller</dt>
              <dd>Derive, longs couloirs, zones repetitives et environnements metalliques</dd>
            </div>
          </dl>
          <p>
            Tres confortable pour de la reconnaissance, du volume interieur ou un premier passage
            rapide. Le gain de temps est reel, mais il ne remplace pas une strategie de controle.
          </p>
          <a class="tool-card__cta" href="/minute-topo/">Comprendre la derive SLAM</a>
        </article>

        <article class="tool-card tool-card--wide tool-card--starter">
          <span class="tool-card__badge">Premier achat</span>
          <h3>Je debute et je ne veux pas acheter trop vite</h3>
          <dl class="tool-card__facts">
            <div>
              <dt>Outil conseille</dt>
              <dd>Cibles, stockage, PC stable, logiciel de lecture et methode de controle</dd>
            </div>
            <div>
              <dt>A surveiller</dt>
              <dd>Acheter un capteur cher avant de savoir expliquer le livrable attendu</dd>
            </div>
          </dl>
          <p>
            Le capteur vient apres, quand le type de chantier est clair. Avant ca, les petits achats
            et une bonne methode evitent deja beaucoup de chantiers refaits.
          </p>
          <a class="tool-card__cta" href="/ressources/outils-drone-photogrammetrie/"
            >Voir les ressources materiel</a
          >
        </article>
      </div>
    </div>
  </section>

  <section class="start-section start-section--alt">
    <div class="container split-layout">
      <div>
        <p class="eyebrow">Methode</p>
        <h2>Les 5 contenus a lire en premier</h2>
        <p class="section-intro">
          Une selection courte, dans un ordre logique. Tu peux tout lire en une soiree, puis revenir
          chercher le detail quand tu en as besoin.
        </p>
      </div>

      <div class="reading-list">
        <a href="/glossaire/nuage-de-points/" class="reading-item">
          <span>01</span>
          <strong>Nuage de points</strong>
          <em>Pour comprendre l'objet central de tout le site.</em>
        </a>
        <a href="/articles/lidar-hd-ign/" class="reading-item">
          <span>02</span>
          <strong>LiDAR HD IGN</strong>
          <em>Pour manipuler une vraie donnee gratuite et utile.</em>
        </a>
        <a href="/articles/workflow-drone-complet/" class="reading-item">
          <span>03</span>
          <strong>Workflow drone complet</strong>
          <em>Pour voir une chaine acquisition - traitement - export.</em>
        </a>
        <a href="/articles/dji-matrice-4e-photogrammetrie/" class="reading-item">
          <span>04</span>
          <strong>DJI Matrice 4E</strong>
          <em>Pour lire un test materiel avec un angle terrain.</em>
        </a>
        <a href="/articles/pdal-introduction/" class="reading-item">
          <span>05</span>
          <strong>PDAL</strong>
          <em>Pour comprendre pourquoi l'automatisation devient vite utile.</em>
        </a>
      </div>
    </div>
  </section>

  <section class="container start-section">
    <div class="material-panel">
      <div>
        <p class="eyebrow">Materiel & ressources</p>
        <h2>Choisir son materiel sans se faire pieger</h2>
        <p>
          Le meilleur achat, ce n'est pas toujours le capteur le plus cher. C'est souvent
          l'accessoire, le logiciel ou le workflow qui t'evite de refaire un chantier.
        </p>
        <p>
          Sur Topolia, les pages ressources servent a separer ce que j'utilise vraiment, ce que je
          testerais avec prudence, et ce qui ressemble surtout a du marketing. Certains liens
          peuvent etre affilies, mais la logique reste la meme : recommander ce qui a un interet
          terrain.
        </p>
        <a href="/ressources/outils-drone-photogrammetrie/" class="text-cta">
          Voir les outils drone photogrammetrie →
        </a>
      </div>

      <ul class="material-list">
        <li>Accessoires terrain : cibles, GCP, carnet, jalons.</li>
        <li>Capteurs : drone photo, LiDAR drone, scanner statique ou mobile.</li>
        <li>
          Traitement : PC, SSD, RAM, logiciels, formats <a href="/glossaire/las/">LAS</a> /
          <a href="/glossaire/laz/">LAZ</a> / <a href="/glossaire/e57/">E57</a>.
        </li>
        <li>
          Controle : precision, <a href="/glossaire/recalage/">recalage</a>, verification terrain.
        </li>
      </ul>
    </div>
  </section>

  <section class="start-section start-section--dark">
    <div class="container dark-grid">
      <div>
        <p class="eyebrow eyebrow--light">Sources & confiance</p>
        <h2>Du contenu sourcé, puis traduit en langage terrain</h2>
        <p>
          Les definitions et les chiffres viennent de sources solides quand c'est factuel : IGN,
          EASA/DGAC, documentations CloudCompare, PDAL, Agisoft, specs constructeurs. Ensuite, je
          les remets dans le contexte chantier : ce que ca change vraiment quand tu es dehors, avec
          des batteries, du vent, un client et un fichier a livrer.
        </p>
      </div>
      <div class="source-links">
        <a
          href="https://cartes.gouv.fr/rechercher-une-donnee/dataset/IGNF_NUAGES-DE-POINTS-LIDAR-HD"
          target="_blank"
          rel="noopener noreferrer">IGN - LiDAR HD</a
        >
        <a href="https://pdal.io/en/stable/" target="_blank" rel="noopener noreferrer"
          >PDAL documentation</a
        >
        <a href="https://cloudcompare.org/doc/wiki/" target="_blank" rel="noopener noreferrer"
          >CloudCompare wiki</a
        >
        <a
          href="https://support.pix4d.com/hc/en-us/articles/202559809"
          target="_blank"
          rel="noopener noreferrer">Pix4D - GSD</a
        >
      </div>
    </div>
  </section>

  <section class="container start-section">
    <div class="faq-layout">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>Questions frequentes</h2>
        <p class="section-intro">
          Des reponses courtes pour t'orienter. Les pages liees donnent ensuite le detail.
        </p>
      </div>
      <div class="faq-list">
        {
          faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="newsletter-band">
    <div class="container newsletter-wrap">
      <NewsletterInline variant="dark" />
    </div>
  </section>
</BaseLayout>

<style>
  .start-hero {
    padding: 76px 0 52px;
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-alt) 100%);
  }

  .start-hero__grid,
  .split-layout,
  .dark-grid,
  .faq-layout {
    display: grid;
    gap: 32px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .eyebrow--light {
    color: var(--accent-2);
  }

  h1,
  h2 {
    font-family: var(--display);
    color: var(--ink);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  h1 {
    font-size: clamp(2.25rem, 7vw, 4.7rem);
    max-width: 820px;
  }

  h2 {
    font-size: clamp(1.55rem, 4vw, 2.45rem);
  }

  .hero-sub,
  .section-intro {
    margin-top: 18px;
    color: var(--ink-3);
    font-size: 1.08rem;
    line-height: 1.65;
    max-width: 650px;
  }

  .hero-sub a,
  .route-card a,
  .material-list a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: 650;
    text-decoration: none;
  }

  .btn--primary {
    background: var(--ink);
    color: var(--surface);
  }

  .btn--secondary {
    color: var(--ink-2);
    border: 1px solid var(--hairline-strong);
    background: var(--surface);
  }

  .hero-note,
  .route-card,
  .material-panel {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
  }

  .hero-note {
    padding: 22px;
    align-self: end;
  }

  .hero-note__label,
  .route-card__kicker {
