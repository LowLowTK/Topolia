---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://topolia.fr';

const liveTools = [
  {
    title: 'Calculateur GSD drone',
    eyebrow: 'Résolution image',
    description:
      "Calcule la taille d'un pixel au sol, l'emprise d'une photo et la surface couverte selon ton altitude, ton capteur et ta focale.",
    href: '/outils/calculateur-gsd-drone/',
    primary: 'Ouvrir le calculateur GSD',
    facts: ['GSD en cm/px', 'Presets DJI', 'Emprise photo'],
  },
  {
    title: 'Calculateur mission drone',
    eyebrow: 'Préparation de vol',
    description:
      'Estime le nombre de photos, le temps de vol, les batteries à prévoir et la surface tracée sur carte avant ton plan de vol final.',
    href: '/outils/calculateur-mission-drone/',
    primary: 'Ouvrir le calculateur mission',
    facts: ['Photos estimées', 'Carte de zone', 'Batteries'],
  },
];

const upcomingTools = [
  {
    title: 'Calculateur stockage nuage',
    description:
      "Prévois la taille d'un projet E57, RCP ou LAS selon ton scanner, ton nombre de stations et ta densité de points.",
    category: 'Scanner 3D',
  },
  {
    title: 'Convertisseur de pente',
    description:
      'Convertis rapidement une pente en pourcentage, degrés ou ratio pour tes notes terrain.',
    category: 'Topographie',
  },
];

const workflowSteps = [
  {
    title: 'Choisis ton niveau de détail',
    text: 'Commence par le GSD pour savoir si ton altitude donne assez de précision image pour le chantier.',
  },
  {
    title: 'Estime le volume de mission',
    text: 'Passe ensuite au calculateur mission pour anticiper les photos, le temps de vol et les batteries.',
  },
  {
    title: 'Valide dans ton logiciel',
    text: 'Utilise Topolia comme pré-étude, puis confirme le plan de vol, les zones et la sécurité dans tes outils officiels.',
  },
];

const readingLinks = [
  {
    title: 'Estimer une mission drone photogrammétrie',
    href: '/articles/estimer-mission-drone-photogrammetrie/',
    description: 'Le guide compagnon pour passer du GSD à la surface, aux photos et aux batteries.',
  },
  {
    title: 'Workflow drone complet',
    href: '/articles/workflow-drone-complet/',
    description: 'La suite logique après la préparation : vol, traitement et contrôle qualité.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Outils Topolia',
  url: `${siteUrl}/outils/`,
  inLanguage: 'fr-FR',
  itemListElement: liveTools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${siteUrl}${tool.href}`,
    name: tool.title,
  })),
});
---

<BaseLayout
  title="Outils gratuits pour la topographie, le drone et le scan 3D"
  description="Calculateurs gratuits pour préparer tes missions drone, scan 3D et topographie : GSD, emprise photo, mission photogrammétrique, stockage nuage de points."
  jsonLd={jsonLd}
>
  <main class="tools-page">
    <section class="tools-hero">
      <div class="container tools-hero__inner">
        <div>
          <p class="tools-hero__eyebrow">Outils Topolia</p>
          <h1>Prépare tes missions terrain avec des chiffres clairs.</h1>
          <p>
            Les calculateurs Topolia t'aident à cadrer une mission drone ou topo avant de passer au
            terrain : résolution attendue, emprise photo, durée de vol, batteries et surface à
            couvrir.
          </p>
        </div>

        <div class="tools-hero__panel" aria-label="Outils disponibles">
          <span>2 outils prêts</span>
          <strong>Drone</strong>
          <p>GSD, surface tracée, photos et batteries.</p>
        </div>
      </div>
    </section>

    <section class="container tools-featured" aria-labelledby="tools-featured-title">
      <div class="tools-section-head">
        <p>Disponibles maintenant</p>
        <h2 id="tools-featured-title">Les calculateurs à utiliser en premier</h2>
      </div>

      <div class="tools-featured__grid">
        {
          liveTools.map((tool) => (
            <article class="tool-card tool-card--live">
              <p class="tool-card__eyebrow">{tool.eyebrow}</p>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
              <ul aria-label={`Points clés ${tool.title}`}>
                {tool.facts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>
              <a href={tool.href}>{tool.primary}</a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="tools-workflow" aria-labelledby="tools-workflow-title">
      <div class="container tools-workflow__inner">
        <div class="tools-section-head">
          <p>Ordre conseillé</p>
          <h2 id="tools-workflow-title">Un parcours simple avant de décoller</h2>
        </div>

        <ol class="tools-workflow__list">
          {
            workflowSteps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="container tools-upcoming" aria-labelledby="tools-upcoming-title">
      <div class="tools-section-head">
        <p>À venir</p>
        <h2 id="tools-upcoming-title">Les prochains outils utiles au terrain</h2>
      </div>

      <div class="tools-upcoming__grid">
        {
          upcomingTools.map((tool) => (
            <article class="tool-card tool-card--soon">
              <div class="tool-card__meta">
                <span>{tool.category}</span>
                <span>Bientôt</span>
              </div>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="container tools-reading" aria-labelledby="tools-reading-title">
      <div class="tools-section-head">
        <p>À lire avec les outils</p>
        <h2 id="tools-reading-title">Les guides qui donnent le contexte</h2>
      </div>

      <div class="tools-reading__grid">
        {
          readingLinks.map((link) => (
            <a href={link.href} class="tools-reading__link">
              <span>{link.title}</span>
              <p>{link.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="container tools-note" aria-label="Contact outils">
      <p>
        Si tu veux ajouter une donnée drone, un preset caméra ou une idée d'outil, contacte-nous à
        contact@topolia.fr.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .tools-page {
    background: var(--bg);
  }

  .tools-hero {
    padding: 64px 0 48px;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--hairline);
  }

  .tools-hero__inner {
    display: grid;
    gap: 28px;
    align-items: end;
  }

  .tools-hero__eyebrow,
  .tools-section-head p,
  .tool-card__eyebrow {
    margin-bottom: 12px;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tools-hero h1 {
    max-width: 900px;
    font-family: var(--display);
    font-size: clamp(2.1rem, 6vw, 4.35rem);
    font-weight: 800;
    line-height: 1.03;
    color: var(--ink);
  }

  .tools-hero h1 + p {
    max-width: 720px;
    margin-top: 18px;
    color: var(--ink-3);
    font-size: 1.08rem;
  }

  .tools-hero__panel {
    border: 1px solid var(--hairline-strong);
    border-radius: 8px;
    padding: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .tools-hero__panel span {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    border: 1px solid var(--green);
    border-radius: 999px;
    padding: 4px 10px;
    color: var(--green);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .tools-hero__panel strong {
    display: block;
    margin-top: 16px;
    color: var(--ink);
    font-family: var(--display);
    font-size: 1.55rem;
    line-height: 1.1;
  }

  .tools-hero__panel p {
    margin-top: 8px;
    color: var(--ink-3);
  }

  .tools-featured,
  .tools-upcoming,
  .tools-reading {
    padding-top: 48px;
    padding-bottom: 56px;
  }

  .tools-section-head {
    max-width: 720px;
    margin-bottom: 22px;
  }

  .tools-section-head h2 {
    font-family: var(--display);
    font-size: clamp(1.55rem, 4vw, 2.35rem);
    font-weight: 800;
    line-height: 1.12;
    color: var(--ink);
  }

  .tools-featured__grid,
  .tools-upcoming__grid {
    display: grid;
    gap: 18px;
  }

  .tools-reading {
    padding-top: 0;
  }

  .tools-reading__grid {
    display: grid;
    gap: 12px;
  }

  .tools-reading__link {
    display: grid;
    gap: 8px;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 18px;
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .tools-reading__link span {
    color: var(--accent);
    font-weight: 800;
  }

  .tools-reading__link p {
    color: var(--ink-3);
  }

  .tools-reading__link:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 22px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .tool-card--live {
    min-height: 310px;
  }

  .tool-card h3 {
    color: var(--ink);
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.16;
  }

  .tool-card p {
    margin-top: 12px;
    color: var(--ink-3);
  }

  .tool-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .tool-card li {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    padding: 4px 10px;
    color: var(--ink-2);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .tool-card a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: auto;
    border-radius: 8px;
    padding: 10px 16px;
    background: var(--ink);
    color: var(--surface);
    font-weight: 800;
    text-decoration: none;
  }

  .tool-card a:hover {
    opacity: 0.86;
  }

  .tools-workflow {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--surface);
  }

  .tools-workflow__inner {
    padding-top: 48px;
    padding-bottom: 48px;
  }

  .tools-workflow__list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tools-workflow__list li {
    border-left: 4px solid var(--accent);
    padding: 16px 18px;
    background: var(--bg-alt);
  }

  .tools-workflow__list span {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 800;
  }

  .tools-workflow__list h3 {
    margin-top: 8px;
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .tools-workflow__list p {
    margin-top: 8px;
    color: var(--ink-3);
  }

  .tool-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tool-card__meta span:last-child {
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    padding: 4px 9px;
  }

  .tools-note {
    padding-bottom: 84px;
  }

  .tools-note p {
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 18px;
    background: var(--surface);
    color: var(--ink-3);
    font-weight: 700;
  }

  @media (min-width: 760px) {
    .tools-featured__grid,
    .tools-upcoming__grid,
    .tools-reading__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .tools-hero__inner {
      grid-template-columns: minmax(0, 1fr) 300px;
    }

    .tools-workflow__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
