    name: 'PC Photogrammétrie Expert',
    description:
      'Station très musclée avec Ryzen 9 9950X3D, RTX 5080 et 64 Go de DDR5 selon la fiche produit. Bien plus cohérente pour les gros lots photo, les nuages lourds et les exports exigeants qu’un mini-PC sans GPU dédié.',
    price: '3 500 €+',
    affiliateUrl: 'https://www.amazon.fr/Sedatech-Gamer-5080-Ryzen-9950X3D/dp/B0GXLJ3QWV/',
    utmContent: 'pc-photogrammetrie-expert',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
  {
    name: 'PC portable photogrammétrie mobilité',
    description:
      'Option à garder si tu as vraiment besoin de traiter ou contrôler des données en déplacement. Pratique sur le terrain, mais moins performant qu’une tour à prix équivalent à cause du refroidissement, de la puissance GPU limitée et de l’évolutivité réduite.',
    price: 'Budget élevé',
    affiliateUrl: 'https://www.amazon.fr/ASUS-RyzenTM-LPDDR5X-NVIDIA%C2%AE-GeForce/dp/B0GC89XJX8/',
    utmContent: 'pc-portable-photogrammetrie-mobilite',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
  {
    name: 'RAM 64 Go minimum',
    description:
      'La RAM évite les blocages sur les gros lots de photos. Pour démarrer sérieusement, 64 Go est plus confortable que 32 Go, mais je ne recommande pas l’achat en ce moment : les prix sont trop hauts à cause de l’actualité du marché RAM.',
    price: 'Selon génération',
    affiliateUrl: 'https://www.amazon.fr/s?k=ram+64go+ddr5+pc',
    utmContent: 'ram-64go-photogrammetrie',
    source: 'amazon' as const,
    isPlaceholder: true,
    purchasePaused: true,
    pausedLabel: 'Achat déconseillé',
  },
  {
    name: 'Disque dur externe Seagate Portable',
    description:
      'Un disque de sauvegarde séparé du SSD de travail. Une mission drone représente souvent plusieurs dizaines de Go : garde toujours une copie avant de lancer les traitements lourds.',
    price: 'Selon capacité',
    affiliateUrl: 'https://www.amazon.fr/Seagate-Portable-1TB-Disque-Externe/dp/B07CRGSR16/',
    utmContent: 'sauvegarde-externe-drone',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
  {
    name: 'Support double écran BONTEC',
    description:
      'Accessoire bonus utile si tu fais beaucoup de tri photo, contrôle qualité ou comparaison d’orthophotos. Le double écran rend le travail plus confortable, surtout avec logiciel, explorateur de fichiers et carte ouverts en même temps.',
    price: 'Petit budget',
    affiliateUrl:
      'https://www.amazon.fr/BONTEC-Moniteurs-R%C3%A9glable-Inclinable-Pivotant/dp/B01MR397OH/',
    utmContent: 'support-double-ecran-bontec',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
];

const logicielsEssentiels = [
  {
    name: 'Agisoft Metashape Professional',
    description:
      'Le logiciel principal si tu veux garder la main sur la photogrammétrie : alignement, GCP, nuage dense, MNT, orthophoto et exports pro.',
    price: 'Prix à vérifier sur le site officiel',
    affiliateUrl: 'https://www.agisoft.com/buy/',
    utmContent: 'metashape-pro',
    source: 'editeur' as const,
    isPlaceholder: false,
  },
  {
    name: 'Pix4Dmatic',
    description:
      'Alternative solide pour les grands projets drone et les workflows Pix4D. À comparer avec Metashape selon tes habitudes et ton volume.',
    price: 'Prix à vérifier sur le site officiel',
    affiliateUrl: 'https://www.pix4d.com/product/pix4dmatic/',
    utmContent: 'pix4dmatic',
    source: 'editeur' as const,
    isPlaceholder: false,
  },
  {
    name: 'CloudCompare',
    description:
      'Indispensable pour contrôler un nuage de points, mesurer, nettoyer, comparer et vérifier rapidement avant livraison.',
    price: 'Gratuit',
    affiliateUrl: 'https://www.cloudcompare.org/',
    utmContent: 'cloudcompare',
    source: 'autre' as const,
    isPlaceholder: false,
  },
  {
    name: 'QGIS',
    description:
      'Le compagnon SIG pour vérifier les orthophotos, croiser des données et préparer des livrables cartographiques simples.',
    price: 'Gratuit',
    affiliateUrl: 'https://qgis.org/',
    utmContent: 'qgis',
    source: 'autre' as const,
    isPlaceholder: false,
  },
];

const quickLinks = [
  { href: '#terrain', label: 'Terrain' },
  { href: '#acquisition', label: 'Acquisition' },
  { href: '#informatique', label: 'Informatique' },
  { href: '#logiciels', label: 'Logiciels' },
];

const decisionSteps = [
  {
    title: 'Avant le vol',
    text: 'Sécurise les GCP, les notes terrain et la préparation de mission. C’est la partie qui évite les mauvaises surprises.',
  },
  {
    title: 'Pendant le traitement',
    text: 'Priorise le stockage rapide, la RAM et un GPU NVIDIA correct avant de chercher une configuration extrême.',
  },
  {
    title: 'Pour le logiciel',
    text: 'Choisis selon ton volume de chantiers, tes exports et ton besoin de contrôle. Metashape reste une valeur sûre pour travailler finement.',
  },
];
---

<BaseLayout
  title="Matériel & logiciels pour la photogrammétrie drone"
  description="Accessoires terrain, matériel informatique et logiciels utiles pour préparer, voler et traiter une mission drone en photogrammétrie."
  ogImage="/og/ressources-outils.png"
>
  <main class="ressources-page">
    <header class="ressources-hero">
      <div class="container ressources-hero__inner">
        <div>
          <p class="ressources-hero__eyebrow">Ressources drone</p>
          <h1>Matériel & logiciels pour la photogrammétrie drone</h1>
          <p>
            Une sélection courte pour préparer, voler et traiter une mission photogrammétrique sans
            acheter du matériel inutile. On repart de zéro : seulement les essentiels, pas une
            vitrine remplie pour faire joli.
          </p>
        </div>

        <nav class="ressources-hero__nav" aria-label="Sections de la page">
          {quickLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </header>

    <div class="container ressources-page__container">
      <section class="ressources-tools" aria-label="Outils de préparation Topolia">
        <div>
          <p class="ressources-tools__eyebrow">Avant d’acheter</p>
          <h2>Calcule d’abord ton besoin réel</h2>
          <p>
            Avant de choisir un drone, un PC ou un logiciel, estime le GSD, le nombre de photos et
            les batteries. Ça évite de surdimensionner une configuration ou de sous-préparer le
            terrain.
          </p>
        </div>
        <div class="ressources-tools__links">
          <a href="/outils/calculateur-gsd-drone/">Calculateur GSD</a>
          <a href="/outils/calculateur-mission-drone/">Calculateur mission</a>
          <a href="/articles/pourquoi-photogrammetrie-lourde-traitement/">
            Pourquoi le traitement est lourd
          </a>
        </div>
      </section>

      <AffiliateDisclaimer />

      <section class="ressources-method" aria-labelledby="ressources-method-title">
        <div class="ressources-section__head">
          <p>Choisir dans le bon ordre</p>
          <h2 id="ressources-method-title">La méthode simple</h2>
        </div>
        <ol class="ressources-method__list">
          {
            decisionSteps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="ressources-section" id="terrain">
        <div class="ressources-section__head">
          <p>Terrain</p>
          <h2 class="ressources-section__title">Accessoires terrain</h2>
        </div>
        <p class="ressources-section__subtitle">
          Les produits qui donnent une vraie référence terrain à ton modèle, au lieu de produire une
          belle orthophoto impossible à contrôler.
        </p>
        <div class="ressources-section__grid">
          {terrainEssentiel.map((p) => <ProductCard {...p} />)}
        </div>
      </section>

      <section class="ressources-section" id="acquisition">
        <div class="ressources-section__head">
          <p>Acquisition</p>
          <h2 class="ressources-section__title">Pendant le vol</h2>
        </div>
        <p class="ressources-section__subtitle">
          Ce qui sécurise la récupération des photos et évite les pertes de temps dès le retour au
          bureau.
        </p>
        <div class="ressources-section__grid">
          {acquisitionEssentielle.map((p) => <ProductCard {...p} />)}
        </div>
      </section>

      <section class="ressources-section" id="informatique">
        <div class="ressources-section__head">
          <p>Traitement</p>
          <h2 class="ressources-section__title">Informatique & stockage</h2>
        </div>
        <p class="ressources-section__subtitle">
          Trois niveaux de budget pour choisir sans te perdre : débutant, pro ou expert. Dans tous
          les cas, vise une machine équilibrée plutôt qu’une seule pièce très chère dans une config
          bancale.
        </p>
        <div class="ressources-section__grid">
          {traitementEssentiel.map((p) => <ProductCard {...p} />)}
        </div>
      </section>

      <section class="ressources-section" id="logiciels">
        <div class="ressources-section__head">
          <p>Logiciels</p>
          <h2 class="ressources-section__title">Logiciels photogrammétrie</h2>
        </div>
        <p class="ressources-section__subtitle">
          Le minimum pour produire, contrôler et exploiter les livrables. Les prix logiciels bougent
          souvent : vérifie toujours la page officielle avant achat. Aucun lien logiciel de cette
          section n’est affilié.
        </p>
        <div class="ressources-section__grid">
          {logicielsEssentiels.map((p) => <ProductCard {...p} />)}
        </div>
      </section>

      <footer class="ressources-page__footer">
        <p>
          <strong>Comment je sélectionne ces outils :</strong> je ne liste que ce que j'utilise dans mon
          activité, ce que j'ai eu l'occasion de tester sérieusement ou ce qui répond à un besoin terrain
          précis. Les prix sont indicatifs et peuvent varier. Pour toute question sur un outil, tu peux
          me contacter directement.
        </p>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  .ressources-page {
    background: var(--bg);
  }

  .ressources-hero {
    border-bottom: 1px solid var(--hairline);
    padding: 64px 0 44px;
    background: var(--bg-alt);
  }

  .ressources-hero__inner {
    display: grid;
    gap: 24px;
    align-items: end;
  }

  .ressources-hero__eyebrow,
  .ressources-tools__eyebrow,
  .ressources-section__head p {
    margin-bottom: 12px;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .ressources-hero h1 {
    max-width: 900px;
    font-family: var(--display);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.03;
    color: var(--ink);
  }

  .ressources-hero h1 + p {
    max-width: 720px;
    margin-top: 18px;
    color: var(--ink-3);
    font-size: 1.08rem;
  }

  .ressources-hero__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ressources-hero__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    padding: 6px 12px;
    background: var(--surface);
    color: var(--ink-2);
    font-weight: 800;
    text-decoration: none;
  }

  .ressources-hero__nav a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ressources-page__container {
    padding-top: 36px;
    padding-bottom: 84px;
  }

  .ressources-tools {
    display: grid;
    gap: 18px;
    margin-bottom: 20px;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .ressources-tools h2,
  .ressources-section__title {
    font-family: var(--display);
    font-size: clamp(1.35rem, 4vw, 2rem);
    font-weight: 800;
    line-height: 1.12;
    color: var(--ink);
  }

  .ressources-tools p {
    margin-top: 10px;
    color: var(--ink-3);
  }

  .ressources-tools__links {
    display: grid;
    gap: 8px;
  }

  .ressources-tools__links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 8px;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--surface);
    font-weight: 800;
    text-decoration: none;
  }

  .ressources-tools__links a:hover {
    opacity: 0.86;
  }

  .ressources-method {
    margin-top: 36px;
    margin-bottom: 44px;
  }

  .ressources-method__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ressources-method__list li {
    border-left: 4px solid var(--accent);
    padding: 16px;
    background: var(--surface);
  }

  .ressources-method__list span {
    font-family: var(--mono);
    color: var(--accent);
    font-weight: 800;
  }

  .ressources-method__list h3 {
    margin-top: 8px;
    color: var(--ink);
    font-size: 1.04rem;
  }

  .ressources-method__list p {
    margin-top: 8px;
    color: var(--ink-3);
  }

  .ressources-section {
    scroll-margin-top: 96px;
    margin-bottom: 48px;
  }

  .ressources-section__head {
    margin-bottom: 10px;
  }

  .ressources-section__subtitle {
    max-width: 720px;
    color: var(--ink-3);
    margin: 0 0 18px;
  }

  .ressources-section__grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ressources-page__footer {
    margin-top: 40px;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 18px;
    background: var(--surface);
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .ressources-page__footer strong {
    color: var(--ink);
  }

  @media (min-width: 760px) {
    .ressources-tools {
      grid-template-columns: minmax(0, 1fr) 240px;
      align-items: center;
    }

    .ressources-method__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .ressources-hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
