---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateDisclaimer from '../../components/ressources/AffiliateDisclaimer.astro';
import ProductCard from '../../components/ressources/ProductCard.astro';

// Données produits à compléter par Loïc avec ce qu'il utilise vraiment.
// isPlaceholder: true = lien pas encore affilié, affiché avec note visuelle.

const terrainEssentiel = [
  {
    name: 'Mires GCP lavables',
    description:
      "Le premier achat utile si tu fais de la photogrammétrie topo. Elles servent à caler le modèle sur des points mesurés et à contrôler l'erreur finale.",
    price: 'À partir de quelques dizaines d’euros',
    affiliateUrl:
      'https://www.amazon.fr/marques-contr%C3%B4le-points-r%C3%A9f%C3%A9rence-marquages/dp/B0H1J78R9D/',
    utmContent: 'mires-gcp-lavables',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
  {
    name: 'DJI D-RTK 3 Multifunctional Station',
    description:
      'La station GNSS officielle DJI pour sécuriser le RTK avec les drones Enterprise compatibles. Très cohérente si tu travailles déjà en écosystème DJI, notamment comme base locale ou station rover selon le workflow.',
    price: 'Prix à vérifier sur le site officiel',
    affiliateUrl: 'https://enterprise.dji.com/d-rtk-3',
    utmContent: 'dji-d-rtk-3',
    source: 'autre' as const,
    isPlaceholder: true,
  },
  {
    name: 'Kit de cônes et signalisation chantier',
    description:
      'Un kit simple pour matérialiser une zone, protéger un point de contrôle ou rendre une intervention plus lisible sur site. Utile dès que tu travailles près d’un accès, d’un parking ou d’une zone fréquentée.',
    price: 'Petit budget',
    affiliateUrl:
      'https://www.amazon.fr/signalisation-lentreprise-dinterdiction-stationner-imperm%C3%A9ables/dp/B09776BZFM/',
    utmContent: 'kit-marquage-terrain',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
];

const acquisitionEssentielle = [
  {
    name: 'Cartes mémoire rapides et fiables',
    description:
      'Prends plusieurs cartes plutôt qu’une seule énorme carte. En mission, une carte qui lâche ne doit jamais bloquer toute la journée.',
    price: 'Selon capacité',
    affiliateUrl: 'https://www.amazon.fr/SanDisk-Cards-Extreme-MICROSDXC-ADAPATER/dp/B09X7CRKRZ/',
    utmContent: 'cartes-memoire-drone',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
  {
    name: 'Lecteur de cartes SD / microSD USB-C BENFEI',
    description:
      "Petit accessoire, gros gain de temps. Il évite de brancher le drone pour chaque transfert et limite l'usure du matériel.",
    price: 'Petit budget',
    affiliateUrl:
      'https://www.amazon.fr/Lecteur-Carte-m%C3%A9moire-BENFEI-Adaptateur/dp/B08P517NW5/',
    utmContent: 'lecteur-cartes-usb-c',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
  {
    name: 'SSD externe Crucial X9 2 To',
    description:
      'Le vrai disque de navette entre terrain, portable et station de traitement. Vise 2 To si tu enchaînes les chantiers ou les exports LAS/E57.',
    price: 'Selon capacité',
    affiliateUrl:
      'https://www.amazon.fr/Crucial-Externe-Portable-Compatible-PlayStation/dp/B0CGW18S6Y/',
    utmContent: 'ssd-externe-nvme-2to',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
];

const traitementEssentiel = [
  {
    name: 'PC Photogrammétrie Débutant',
    description:
      'Configuration d’entrée sérieuse avec Ryzen 7 7800X3D, 32 Go de RAM DDR5, SSD M.2 1 To et RTX 5060 8 Go. Bien pour démarrer sur des petits lots photo, avec une limite logique côté RAM et VRAM dès que les projets grossissent.',
    price: '1 200 - 1 800 €',
    affiliateUrl: 'https://www.amazon.fr/Memory-PC-7800X3D-NVIDIA-Windows/dp/B0CLDMRPWL/',
    utmContent: 'pc-photogrammetrie-debutant',
    source: 'amazon' as const,
    isPlaceholder: true,
  },
  {
    name: 'PC Photogrammétrie Pro',
    description:
      'Tour orientée calcul avec Core i9-14900KF, RTX 5060 Ti, 64 Go de RAM et SSD 2 To selon la fiche produit. Bon cran au-dessus pour traiter plus vite les chantiers réguliers, avec une base mémoire plus cohérente pour la photogrammétrie.',
    price: '2 000 - 3 000 €',
    affiliateUrl:
      'https://www.amazon.fr/AURUMPC-i9-14900KF-RTX5060Ti-Refroidissement-Ordinateur/dp/B0FGY8B52C/',
